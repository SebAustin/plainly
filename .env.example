# Firebase web app config (Project settings → General → Your apps).
# These identify the project; they are not secrets. Copy to .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# App Check. On localhost, "true" prints a new debug token to the browser
# console; register it in the Firebase console, then paste it here.
VITE_APPCHECK_DEBUG_TOKEN=true
# Production attestation (hosted builds).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
